%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#161718", "primaryTextColor": "#e9e9e6", "primaryBorderColor": "#2e2f32", "lineColor": "#6f6e69", "edgeLabelBackground": "#101011", "fontSize": "14px"}, "flowchart": {"curve": "linear", "nodeSpacing": 44, "rankSpacing": 46}}}%%
%% Diligence Room architecture. Mermaid render of diligence-room-vision.md §22.
%% One spine, read top to bottom: documents enter, findings reach the deal lead.
%% Deliberately eleven nodes. An earlier version drew each of the eight
%% workstreams and each compliance control separately, which made a diagram that
%% had to be studied rather than glanced at. Detail that belongs in a label is
%% kept in the label.
%% Render (both exports):
%%   npx -y @mermaid-js/mermaid-cli -i architecture.mmd -o architecture.svg \n%%     -b "#0a0a0b" -p puppeteer-config.json
%%   npx -y @mermaid-js/mermaid-cli -i architecture.mmd -o architecture.png \n%%     -b "#0a0a0b" -p puppeteer-config.json -w 1600
%% The -p config points puppeteer at the installed Chrome: mermaid-cli's own
%% bundled Chromium fails to launch on this machine (exit 3221225595).
flowchart TD
    dataroom["Data room<br/>region-pinned Cloud Storage"]

    ingest["Ingestion<br/>format detection, Document AI parsing"]

    screen["Gemma sentinel and Model Armor<br/>injection tripwire, Cloud DLP scan, quarantine"]

    gateway["Agent Gateway<br/>deny-default policy on cross-workstream reads"]

    registry["Agent Registry<br/>versions, approval, rollback targets"]

    agents["8 agents on Agent Runtime<br/>Legal, Finance, HR, IP/Tech, Tax, Regulatory, ESG, Real Estate<br/>loop guard, evidence gate, crash-resume"]

    memory["Partitioned memory<br/>Firestore org / deal / workstream, event log<br/>Memory Bank: entity context across sessions"]

    coordinator["Coordinator<br/>red-flag scoring, escalation, negotiation drafts"]

    dashboard["Executive dashboard<br/>findings, security, registry, portfolio"]

    observability["Observability<br/>OpenTelemetry spans to Cloud Trace"]

    compliance["Compliance plane<br/>CMEK, VPC-SC, Cloud DLP, region pinning, retention"]

    dataroom --> ingest
    ingest --> screen
    screen -->|cleared| gateway
    registry -.->|approved versions only| agents
    gateway -->|allow| agents
    agents -->|reads and writes pass policy| memory
    memory --> coordinator
    coordinator -->|critical findings| dashboard
    agents -.-> observability
    gateway -.-> observability
    memory -.-> compliance

    %% Only the enforcement chokepoints carry colour; everything else stays
    %% achromatic, per DESIGN.md.
    classDef enforcement fill:#161718,stroke:#e0705c,color:#e9e9e6
    class gateway,screen enforcement
